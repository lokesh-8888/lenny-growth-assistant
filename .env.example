# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.2:3b

# Ingestion Pipeline Configuration
# Path to local raw transcripts directory (defaults to cloned repo in data/raw)
RAW_DATA_PATH=data/raw/lennys-podcast-transcripts
TRANSCRIPT_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts.git
CHUNK_SIZE_TARGET=700
CHUNK_OVERLAP_TARGET=100

# Application & Backend Configuration
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
APP_ENV=development
LOG_LEVEL=INFO

# Optional Cloud LLM Keys (free tier toggles for Phase 3+)
GROQ_API_KEY=
GEMINI_API_KEY=
