# =============================================================================
# The Lenny Growth Assistant — Environment Configuration
# =============================================================================

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth

# Ollama Local Service Configuration (Zero-Cost Local Defaults)
# Use http://localhost:11434 when running directly on host
OLLAMA_BASE_URL=http://localhost:11434
# Optional override for containerized backend (defaults to http://host.docker.internal:11434)
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# Ingestion Pipeline Configuration
RAW_DATA_PATH=data/raw/lennys-podcast-transcripts
TRANSCRIPT_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts.git
CHUNK_SIZE_TARGET=700
CHUNK_OVERLAP_TARGET=100

# Application Ports & Security
FRONTEND_PORT=80
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost"]
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# LLM Routing & Model Configuration
# Primary provider: "ollama" (zero-cost local) or "cloud" (free tier with automatic fallback)
LLM_PROVIDER=ollama

# Optional Free-Tier Cloud LLM Configuration (Groq or Gemini)
# Leave CLOUD_LLM_API_KEY empty to operate entirely on zero-cost local Ollama
CLOUD_LLM_PROVIDER=groq
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=llama-3.3-70b-versatile

# Individual Provider Key Aliases (optional convenience)
GROQ_API_KEY=
GEMINI_API_KEY=

# Grounded RAG Engine Parameters
RAG_TOP_K=4
TOP_K_CHUNKS=4
RAG_SIMILARITY_THRESHOLD=0.40
SIMILARITY_THRESHOLD=0.40
RAG_HISTORY_TURNS=6

# Ship 30 for 30 Skill Configuration
SHIP30_TARGET_WORD_COUNT=1250
SHIP30_WORD_COUNT_TOLERANCE=0.20
