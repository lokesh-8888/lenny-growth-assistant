# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.2:3b

# Ingestion Pipeline Configuration
# Path to local raw transcripts directory (defaults to cloned repo in data/raw)
RAW_DATA_PATH=data/raw/lennys-podcast-transcripts
TRANSCRIPT_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts.git
CHUNK_SIZE_TARGET=700
CHUNK_OVERLAP_TARGET=100

# Application & Backend Configuration
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
APP_ENV=development
LOG_LEVEL=INFO

# LLM Routing & Model Configuration
# Primary provider: "ollama" (mandatory local zero-cost) or "cloud" (free tier with auto-fallback)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b

# Free-Tier Cloud LLM Configuration (OpenAI-compatible)
# Set CLOUD_LLM_PROVIDER to "groq" or "gemini"
CLOUD_LLM_PROVIDER=groq
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=llama-3.3-70b-versatile

# Individual Provider Key Aliases (optional convenience)
GROQ_API_KEY=
GEMINI_API_KEY=

# RAG Engine & Grounded Retrieval Configuration
RAG_TOP_K=4
TOP_K_CHUNKS=4
RAG_SIMILARITY_THRESHOLD=0.40
SIMILARITY_THRESHOLD=0.40
RAG_HISTORY_TURNS=6
